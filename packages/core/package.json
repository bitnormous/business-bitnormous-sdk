{
  "name": "@bitnormous/business-core",
  "version": "1.0.0",
  "description": "Isomorphic core of the Bitnormous Business SDK: transport, types, checkout state machine and webhook verification.",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": ["dist", "README.md"],
  "sideEffects": false,
  "scripts": {
    "build": "tsc -b",
    "clean": "rm -rf dist *.tsbuildinfo"
  },
  "keywords": ["bitnormous", "crypto", "payments", "stablecoin", "usdt", "checkout"],
  "engines": { "node": ">=18" },
  "publishConfig": { "access": "public" }
}
