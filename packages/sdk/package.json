{
  "name": "@bitnormous/business-sdk",
  "version": "1.0.0",
  "description": "Accept crypto payments on your website with a few lines of code. Browser checkout for Bitnormous Business.",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": ["dist", "README.md"],
  "sideEffects": false,
  "scripts": {
    "build": "tsc -b",
    "clean": "rm -rf dist *.tsbuildinfo"
  },
  "dependencies": {
    "@bitnormous/business-core": "1.0.0"
  },
  "keywords": ["bitnormous", "crypto", "payments", "checkout", "usdt", "usdc", "bitcoin", "stablecoin"],
  "publishConfig": { "access": "public" }
}
